+
+// iOS counterpart of vo_mediacodec_embed: decoded frames go straight to an
+// AVSampleBufferDisplayLayer owned by the host (passed as --wid), so the
+// system compositor shows VideoToolbox's YUV buffers without a GL pass.
+// OSD and subtitles are not drawn; the host switches to vo=libmpv for those.
+//
+// --wid may also be a host object answering -mpvDisplayLayers (an NSArray of
+// AVSampleBufferDisplayLayer, read every frame): the same decoded buffer is
+// then shown on each, e.g. the visible layer plus a hidden one feeding system
+// picture-in-picture, without copying pixels.
+
+#import <AVFoundation/AVFoundation.h>
+#import <CoreMedia/CoreMedia.h>
+#import <CoreVideo/CoreVideo.h>
+
+#include <libavutil/hwcontext.h>
+
+#include "common/common.h"
+#include "common/msg.h"
+#include "options/options.h"
+#include "vo.h"
+#include "video/hwdec.h"
+#include "video/mp_image.h"
+
+struct priv {
+    id target;                           // layer or layer provider, retained
+    struct mp_image *next;               // frame to show on flip_page
+    struct mp_hwdec_ctx hwctx;
+    CVPixelBufferPoolRef pool;           // software frames are copied into it
+    struct mp_image_params params;
+};
+
+static int preinit(struct vo *vo)
+{
+    struct priv *p = vo->priv;
+    if (vo->opts->WinID == 0 || vo->opts->WinID == -1) {
+        MP_ERR(vo, "--wid must be an AVSampleBufferDisplayLayer.\n");
+        return -1;
+    }
+    id target = (__bridge id)(void *)(intptr_t)vo->opts->WinID;
+    if (![target isKindOfClass:[AVSampleBufferDisplayLayer class]] &&
+        ![target respondsToSelector:@selector(mpvDisplayLayers)])
+    {
+        MP_ERR(vo, "--wid is not an AVSampleBufferDisplayLayer.\n");
+        return -1;
+    }
+    p->target = target;
+    CFRetain((__bridge CFTypeRef)p->target);
+
+    // Register a VideoToolbox device so the decoder hands over its
+    // CVPixelBuffers (IMGFMT_VIDEOTOOLBOX) instead of copying them back.
+    vo->hwdec_devs = hwdec_devices_create();
+    AVBufferRef *ref = NULL;
+    if (av_hwdevice_ctx_create(&ref, AV_HWDEVICE_TYPE_VIDEOTOOLBOX,
+                               NULL, NULL, 0) >= 0)
+    {
+        p->hwctx = (struct mp_hwdec_ctx){
+            .driver_name = "videotoolbox",
+            .av_device_ref = ref,
+            .hw_imgfmt = IMGFMT_VIDEOTOOLBOX,
+        };
+        hwdec_devices_add(vo->hwdec_devs, &p->hwctx);
+    } else {
+        MP_WARN(vo, "VideoToolbox device unavailable; software frames only.\n");
+    }
+    return 0;
+}
+
+static int query_format(struct vo *vo, int format)
+{
+    return format == IMGFMT_VIDEOTOOLBOX || format == IMGFMT_NV12 ||
+           format == IMGFMT_420P;
+}
+
+static OSType cv_format(int imgfmt)
+{
+    return imgfmt == IMGFMT_NV12 ? kCVPixelFormatType_420YpCbCr8BiPlanarVideoRange
+                                 : kCVPixelFormatType_420YpCbCr8Planar;
+}
+
+static int reconfig(struct vo *vo, struct mp_image_params *params)
+{
+    struct priv *p = vo->priv;
+    p->params = *params;
+    if (p->pool) {
+        CVPixelBufferPoolRelease(p->pool);
+        p->pool = NULL;
+    }
+    if (params->imgfmt == IMGFMT_NV12 || params->imgfmt == IMGFMT_420P) {
+        NSDictionary *attrs = @{
+            (id)kCVPixelBufferPixelFormatTypeKey: @(cv_format(params->imgfmt)),
+            (id)kCVPixelBufferWidthKey: @(params->w),
+            (id)kCVPixelBufferHeightKey: @(params->h),
+            (id)kCVPixelBufferIOSurfacePropertiesKey: @{},
+        };
+        if (CVPixelBufferPoolCreate(NULL, NULL, (__bridge CFDictionaryRef)attrs,
+                                    &p->pool) != kCVReturnSuccess)
+        {
+            MP_ERR(vo, "Could not create a pixel buffer pool.\n");
+            return -1;
+        }
+    }
+    return 0;
+}
+
+// Copies a software frame into a pooled CVPixelBuffer (CPU only, no GPU).
+static CVPixelBufferRef copy_to_buffer(struct priv *p, struct mp_image *mpi)
+{
+    CVPixelBufferRef buf = NULL;
+    if (!p->pool ||
+        CVPixelBufferPoolCreatePixelBuffer(NULL, p->pool, &buf) != kCVReturnSuccess)
+        return NULL;
+    CVPixelBufferLockBaseAddress(buf, 0);
+    for (int n = 0; n < mpi->num_planes; n++) {
+        uint8_t *dst = CVPixelBufferGetBaseAddressOfPlane(buf, n);
+        size_t dst_stride = CVPixelBufferGetBytesPerRowOfPlane(buf, n);
+        int h = mp_image_plane_h(mpi, n);
+        int bytes = (mp_image_plane_w(mpi, n) * mpi->fmt.bpp[n] + 7) / 8;
+        for (int y = 0; y < h; y++)
+            memcpy(dst + y * dst_stride, mpi->planes[n] + y * mpi->stride[n], bytes);
+    }
+    CVPixelBufferUnlockBaseAddress(buf, 0);
+    // Software frames carry no colorimetry; VideoToolbox buffers already do.
+    CFStringRef matrix = mpi->params.color.space == MP_CSP_BT_709
+        ? kCVImageBufferYCbCrMatrix_ITU_R_709_2
+        : kCVImageBufferYCbCrMatrix_ITU_R_601_4;
+    CVBufferSetAttachment(buf, kCVImageBufferYCbCrMatrixKey, matrix,
+                          kCVAttachmentMode_ShouldPropagate);
+    return buf;
+}
+
+static NSArray *target_layers(struct priv *p)
+{
+    if ([p->target isKindOfClass:[AVSampleBufferDisplayLayer class]])
+        return @[p->target];
+    return [p->target performSelector:@selector(mpvDisplayLayers)];
+}
+
+static void enqueue_layer(AVSampleBufferDisplayLayer *layer, CVPixelBufferRef buf)
+{
+    CMVideoFormatDescriptionRef desc = NULL;
+    if (CMVideoFormatDescriptionCreateForImageBuffer(NULL, buf, &desc) != noErr)
+        return;
+    CMSampleTimingInfo timing = {
+        .duration = kCMTimeInvalid,
+        .presentationTimeStamp = kCMTimeInvalid,
+        .decodeTimeStamp = kCMTimeInvalid,
+    };
+    CMSampleBufferRef sample = NULL;
+    OSStatus err = CMSampleBufferCreateReadyWithImageBuffer(NULL, buf, desc,
+                                                            &timing, &sample);
+    CFRelease(desc);
+    if (err != noErr || !sample)
+        return;
+    // mpv already flips at the right time (audio clock): show it now.
+    CFArrayRef list = CMSampleBufferGetSampleAttachmentsArray(sample, true);
+    if (list && CFArrayGetCount(list) > 0) {
+        CFMutableDictionaryRef dict =
+            (CFMutableDictionaryRef)CFArrayGetValueAtIndex(list, 0);
+        CFDictionarySetValue(dict, kCMSampleAttachmentKey_DisplayImmediately,
+                             kCFBooleanTrue);
+    }
+    // A failed layer (e.g. after the app was backgrounded) stays failed
+    // until flushed.
+    if (layer.status == AVQueuedSampleBufferRenderingStatusFailed)
+        [layer flush];
+    [layer enqueueSampleBuffer:sample];
+    CFRelease(sample);
+}
+
+static void enqueue(struct vo *vo, CVPixelBufferRef buf)
+{
+    struct priv *p = vo->priv;
+    @autoreleasepool {
+        for (AVSampleBufferDisplayLayer *layer in target_layers(p))
+            enqueue_layer(layer, buf);
+    }
+}
+
+static void draw_frame(struct vo *vo, struct vo_frame *frame)
+{
+    struct priv *p = vo->priv;
+    if (!frame->current || frame->redraw || frame->repeat)
+        return;
+    mp_image_unrefp(&p->next);
+    p->next = mp_image_new_ref(frame->current);
+}
+
+static void flip_page(struct vo *vo)
+{
+    struct priv *p = vo->priv;
+    struct mp_image *mpi = p->next;
+    if (!mpi)
+        return;
+    p->next = NULL;
+    if (mpi->imgfmt == IMGFMT_VIDEOTOOLBOX) {
+        enqueue(vo, (CVPixelBufferRef)mpi->planes[3]);
+    } else {
+        CVPixelBufferRef buf = copy_to_buffer(p, mpi);
+        if (buf) {
+            enqueue(vo, buf);
+            CVPixelBufferRelease(buf);
+        }
+    }
+    // vo.c keeps its own reference to the current frame for screenshots.
+    talloc_free(mpi);
+}
+
+static int control(struct vo *vo, uint32_t request, void *data)
+{
+    struct priv *p = vo->priv;
+    switch (request) {
+    case VOCTRL_RESET:
+        mp_image_unrefp(&p->next);
+        return VO_TRUE;
+    }
+    return VO_NOTIMPL;
+}
+
+static void uninit(struct vo *vo)
+{
+    struct priv *p = vo->priv;
+    mp_image_unrefp(&p->next);
+    if (p->pool)
+        CVPixelBufferPoolRelease(p->pool);
+    if (p->target) {
+        @autoreleasepool {
+            for (AVSampleBufferDisplayLayer *layer in target_layers(p))
+                [layer flushAndRemoveImage];
+        }
+        CFRelease((__bridge CFTypeRef)p->target);
+        p->target = nil;
+    }
+    if (p->hwctx.av_device_ref) {
+        hwdec_devices_remove(vo->hwdec_devs, &p->hwctx);
+        av_buffer_unref(&p->hwctx.av_device_ref);
+    }
+    hwdec_devices_destroy(vo->hwdec_devs);
+}
+
+const struct vo_driver video_out_avfoundation_embed = {
+    .description = "iOS (Embedded AVSampleBufferDisplayLayer)",
+    .name = "avfoundation_embed",
+    .preinit = preinit,
+    .query_format = query_format,
+    .control = control,
+    .draw_frame = draw_frame,
+    .flip_page = flip_page,
+    .reconfig = reconfig,
+    .uninit = uninit,
+    .priv_size = sizeof(struct priv),
+};
